#!/usr/bin/env php
<?php

if (file_exists(__DIR__ . '/vendor/autoload.php')) {
    require __DIR__ . '/vendor/autoload.php';
} elseif (file_exists(__DIR__ . '/../../autoload.php')) {
    require __DIR__ . '/../../autoload.php';
} else {
    echo "\033[0;31m❌ Ошибка: Не удалось найти автозагрузку Composer!\033[0m\n";
    exit(1);
}

use ComposerHero\Parser;
use ComposerHero\PortChecker;
use ComposerHero\Renderer;

$parser = new Parser();
$portChecker = new PortChecker();
$renderer = new Renderer();

$currentDir = getcwd();
$composeFile = null;

// Список возможных имен конфигурационных файлов докера
$possibleNames = ['docker-compose.yml', 'docker-compose.yaml', 'compose.yml', 'compose.yaml'];

for ($i = 0; $i < 5; $i++) {
    foreach ($possibleNames as $name) {
        $targetFile = $currentDir . '/' . $name;
        if (file_exists($targetFile)) {
            $composeFile = $targetFile;
            break 2; // Выходим сразу из обоих циклов
        }
    }
    
    $parentDir = dirname($currentDir);
    if ($parentDir === $currentDir) {
        break;
    }
    $currentDir = $parentDir;
}

if (!$composeFile) {
    echo "\033[0;31m❌ Ошибка: Файл конфигурации (compose.yml / docker-compose.yml) не найден ни в текущей папке, ни выше!\033[0m\n";
    exit(1);
}

echo "\033[0;34m🔍 Найдена конфигурация: " . $composeFile . "\033[0m\n";

$services = $parser->parse($composeFile);

if ($services === false) {
    echo "\033[0;31m❌ Ошибка: Не удалось прочесть файл. Проверьте синтаксис YAML.\033[0m\n";
    exit(1);
}

if (empty($services)) {
    echo "\033[1;33m⚠️ Предупреждение: В файле конфигурации не найдено ни одного сервиса.\033[0m\n";
    exit(0);
}

$renderer->renderMap($services);

$conflicts = $portChecker->checkPorts($services);
$renderer->renderConflicts($conflicts);
